# Neon (pooled) — use for app runtime / Prisma Client (hostname must include -pooler)
# Verify with: pnpm db:check
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5"

# Neon (direct) — use for Prisma migrations (no -pooler in hostname)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="604800"

# Email provider: "resend" (default) | "ses"
EMAIL_PROVIDER="resend"
EMAIL_FROM="Orvantaa <noreply@orvantaa.com>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_..."

# App URLs — used in emails (team invites, password reset, student credentials)
ADMIN_APP_URL="http://localhost:3001"
STUDENT_APP_URL="http://localhost:3000"

# Public URL for this admin app (client-side links; keep in sync with ADMIN_APP_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Admin seed (pnpm db:seed) — required for prisma/seed.ts
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@orvantaa.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME=""
SEED_ADMIN_GENDER="FEMALE"

# Razorpay (subscription payments) — add credentials to enable sync + webhooks
RAZORPAY_ENABLED="true"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="whsec_..."

# Billing email for payment notifications when school.billingEmail is empty
SUBSCRIPTION_BILLING_EMAIL="billing@school.example.com"

# Cloudflare R2 (S3-compatible) — subject thumbnails and other uploads
# Create API token: R2 → Manage R2 API Tokens. Enable public access via custom domain or r2.dev URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="orvantaa"
# Public base URL for objects (custom domain or https://pub-xxxx.r2.dev)
R2_PUBLIC_URL="https://assets.orvantaa.com"
# Optional override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_ENDPOINT=""
