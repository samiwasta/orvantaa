# Neon (pooled) — use for app runtime / Prisma Client (hostname must include -pooler)
# Verify with: pnpm db:check
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&connection_limit=5"

# Neon (direct) — use for Prisma migrations (no -pooler in hostname)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="604800"

# Email provider: "resend" (default) | "ses"
EMAIL_PROVIDER="resend"
EMAIL_FROM="Orvantaa <noreply@orvantaa.com>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_..."

# App URL — used to build reset-password links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Student dashboard — login links in credential emails (defaults to NEXT_PUBLIC_APP_URL)
STUDENT_APP_URL="http://localhost:3000"

# Admin seed (pnpm db:seed) — required for prisma/seed.ts
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@orvantaa.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME=""
SEED_ADMIN_GENDER="FEMALE"
