# Neon (pooled) — use for app runtime / Prisma Client
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=20&connection_limit=5"

# Neon (direct) — use for Prisma migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN_SECONDS="604800"

# Email provider: "resend" (default) | "ses"
EMAIL_PROVIDER="resend"
EMAIL_FROM="Orvantaa <noreply@orvantaa.com>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY="re_..."

# App URLs — student dashboard (password reset, auth links)
STUDENT_APP_URL="http://localhost:3000"

# Public URL for this student app (client-side links; keep in sync with STUDENT_APP_URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin portal URL (optional on student app; used if cross-app links are needed)
ADMIN_APP_URL="http://localhost:3001"

# AI Tutor provider: groq (free, recommended) | gemini
# If unset, uses Groq when GROQ_API_KEY is set, otherwise Gemini.
AI_TUTOR_PROVIDER="groq"

# Groq — free tier, no billing card required (https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_ENABLED="true"

# Google Gemini — requires billing on Google Cloud for many projects
# GEMINI_API_KEY="AQ.... or AIza...."
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_ENABLED="true"

# Cloudflare R2 public URL — required for Next.js Image on subject thumbnails (same as admin uploads)
R2_PUBLIC_URL="https://assets.orvantaa.com"
