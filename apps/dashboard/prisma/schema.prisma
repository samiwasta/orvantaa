generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  STUDENT
}

enum BoardKind {
  BOARD
  UNIVERSITY
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuizTimedMode {
  UNTIMED
  PER_QUESTION
  WHOLE_QUIZ
}

enum SchoolSubscriptionStatus {
  ACTIVE
  INACTIVE
  HOLD
  BLOCKED
}

enum StudentMailStatus {
  NOT_SENT
  SENT
}

enum SubscriptionPaymentStatus {
  DUE
  SUCCESS
  FAILED
  LATE
  PENDING
}

enum RecurringSubscriptionStatus {
  CREATED
  AUTHENTICATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum AdminNotificationKind {
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  SUBSCRIPTION_PAYMENT_FAILED
  SUBSCRIPTION_PAYMENT_DUE
  SUBSCRIPTION_PAYMENT_LATE
  SCHOOL_SUBSCRIPTION_INACTIVE
  SCHOOL_SUBSCRIPTION_HOLD
  SCHOOL_SUBSCRIPTION_BLOCKED
  STUDENTS_UNASSIGNED
  MAINTENANCE_MODE
  SUPPORT_TICKET
  SYSTEM
}

enum AdminNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AiTutorMessageRole {
  USER
  ASSISTANT
}

enum AiTutorMessageFeedback {
  LIKE
  DISLIKE
}

enum StudentGoalType {
  COMPLETE_CHAPTERS
  REVISE_CHAPTER
  PASS_QUIZ
  IMPROVE_WEAK_AREA
  MAINTAIN_STREAK
}

enum StudentGoalStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  DISMISSED
}

enum StudentGoalSource {
  AI
  SYSTEM
}

enum StudentNotificationKind {
  QUIZ_COMPLETED
  LESSON_COMPLETED
  PASSWORD_CHANGE_REQUIRED
  MAINTENANCE_MODE
  SUPPORT_TICKET
  SYSTEM
}

enum StudentNotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketIssueArea {
  ACCOUNT_PROFILE
  LOGIN_PASSWORD
  SUBJECTS_LESSONS
  QUIZZES
  PERFORMANCE_REPORTS
  AI_TUTOR
  NOTIFICATIONS
  TECHNICAL
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Board / University ───────────────────────────────────────────────────────

model Board {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  kind      BoardKind
  code      String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schools             School[]
  onboardedStudents   User[]    @relation("UserOnboardingBoard")

  @@map("boards")
}

// ─── School ───────────────────────────────────────────────────────────────────

model School {
  id                 String                   @id @default(cuid())
  name               String
  code               String?                  @unique
  boardId            String
  board              Board                    @relation(fields: [boardId], references: [id], onDelete: Restrict)
  city               String?
  state              String?
  subscriptionStatus SchoolSubscriptionStatus @default(INACTIVE)
  billingEmail         String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  classes                 Class[]
  subscriptionPayments    SchoolSubscriptionPayment[]
  recurringSubscription   SchoolRecurringSubscription?
  contacts                SchoolContact[]
  onboardedStudents       User[]                  @relation("UserOnboardingSchool")

  @@index([boardId])
  @@index([name])
  @@map("schools")
}

model SchoolContact {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fullName    String
  designation String
  email       String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@map("school_contacts")
}

model SchoolSubscriptionPayment {
  id                String                    @id @default(cuid())
  schoolId          String
  school            School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactionId     String                    @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  transactionDate   DateTime
  serviceName       String
  paymentMethod     String?
  amountPaise       Int?
  currency          String                    @default("INR")
  status            SubscriptionPaymentStatus @default(PENDING)
  invoiceUrl        String?
  paymentUrl        String?
  emailSentAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([schoolId])
  @@index([transactionDate])
  @@map("school_subscription_payments")
}

model SchoolRecurringSubscription {
  id                     String                      @id @default(cuid())
  schoolId               String                      @unique
  school                 School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  razorpaySubscriptionId String                      @unique
  razorpayPlanId         String
  razorpayCustomerId     String
  status                 RecurringSubscriptionStatus @default(CREATED)
  amountPaise            Int
  principalAmountPaise   Int                         @default(0)
  studentCount           Int                         @default(0)
  currency               String                      @default("INR")
  planName               String
  authUrl                String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextChargeAt           DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([status])
  @@map("school_recurring_subscriptions")
}

// ─── Platform class catalog (grades independent of schools) ───────────────────

model PlatformClass {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_classes")
}

// ─── Class (a grade offered at a school) ────────────────────────────────────────

model Class {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  subjects Subject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

// ─── Section (a division of a class) ────────────────────────────────────────────

model Section {
  id        String   @id @default(cuid())
  name      String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students User[]

  @@unique([classId, name])
  @@index([classId])
  @@map("sections")
}

// ─── Subject ──────────────────────────────────────────────────────────────────

model Subject {
  id         String   @id @default(cuid())
  title      String
  slug       String
  imageUrl   String?
  orderIndex Int      @default(0)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters Chapter[]
  reportCardScores ReportCardSubjectScore[]

  @@unique([classId, slug])
  @@index([classId])
  @@map("subjects")
}

// ─── Chapter ──────────────────────────────────────────────────────────────────

model Chapter {
  id         String   @id @default(cuid())
  title      String
  slug       String
  number     Int
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics  Topic[]
  quizzes Quiz[]

  @@unique([subjectId, number])
  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("chapters")
}

// ─── Topic ──────────────────────────────────────────────────────────────────

model Topic {
  id         String   @id @default(cuid())
  title      String
  slug       String
  orderIndex Int      @default(0)
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes Note[]

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@map("topics")
}

// ─── Note (structured block content) ────────────────────────────────────────────

model Note {
  id         String   @id @default(cuid())
  title      String
  orderIndex Int      @default(0)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  blocks     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  progress NoteProgress[]

  @@index([topicId])
  @@map("notes")
}

// ─── Quiz ──────────────────────────────────────────────────────────────────

model Quiz {
  id               String         @id @default(cuid())
  title            String
  difficulty       QuizDifficulty @default(MEDIUM)
  timedMode        QuizTimedMode  @default(UNTIMED)
  timeLimitSeconds Int?
  orderIndex       Int            @default(0)
  chapterId        String
  chapter          Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([chapterId])
  @@map("quizzes")
}

// ─── Question (MCQ) ──────────────────────────────────────────────────────────

model Question {
  id          String   @id @default(cuid())
  prompt      String
  explanation String?
  orderIndex  Int      @default(0)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options Option[]

  @@index([quizId])
  @@map("questions")
}

// ─── Option (MCQ choice) ──────────────────────────────────────────────────────

model Option {
  id         String   @id @default(cuid())
  label      String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@map("options")
}

// ─── Platform settings (singleton) ───────────────────────────────────────────

model PlatformSettings {
  id                          String   @id @default("platform")
  platformName                String   @default("Orvantaa")
  supportEmail                String   @default("")
  billingEmail                String   @default("")
  emailFromName               String   @default("Orvantaa")
  emailFromAddress            String   @default("")
  studentAppUrl               String   @default("")
  adminAppUrl                 String   @default("")
  timezone                    String   @default("Asia/Kolkata")
  sendStudentCredentialEmails Boolean  @default(true)
  sendSubscriptionEmails      Boolean  @default(true)
  maintenanceMode             Boolean  @default(false)
  maintenanceMessage          String   @default("")
  subscriptionPrincipalAmountPaise Int @default(0)
  subscriptionPlanName        String   @default("Orvantaa Platform Subscription")
  razorpayPlanId              String?
  subscriptionBillingCycles   Int      @default(120)
  autoStartSchoolSubscriptions Boolean @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("platform_settings")
}

model AdminNotification {
  id        String                    @id @default(cuid())
  dedupeKey String                    @unique
  kind      AdminNotificationKind
  priority  AdminNotificationPriority @default(NORMAL)
  title     String
  body      String
  href      String?
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  reads AdminNotificationRead[]

  @@index([createdAt(sort: Desc)])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  id             String            @id @default(cuid())
  notificationId String
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime          @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("admin_notification_reads")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  studentCode  String?  @unique
  phone        String?
  mailStatus   StudentMailStatus @default(NOT_SENT)
  mustChangePassword Boolean @default(false)
  onboardingCompleted Boolean @default(true)
  firstName    String
  lastName     String   @default("")
  dateOfBirth  DateTime?
  gender       Gender   @default(FEMALE)
  role         UserRole @default(STUDENT)
  sectionId    String?
  section      Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  onboardingSchoolId String?
  onboardingSchool   School? @relation("UserOnboardingSchool", fields: [onboardingSchoolId], references: [id], onDelete: SetNull)
  onboardingBoardId  String?
  onboardingBoard    Board?  @relation("UserOnboardingBoard", fields: [onboardingBoardId], references: [id], onDelete: SetNull)
  onboardingCity     String?
  onboardingState    String?
  onboardingStandard String?
  onboardingSection  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  notificationReads   AdminNotificationRead[]
  studentNotifications StudentNotification[]
  aiTutorChatSessions AiTutorChatSession[]
  quizAttempts        QuizAttempt[]
  noteProgress        NoteProgress[]
  reportCard          StudentReportCard?
  supportTickets      SupportTicket[]
  examTarget          StudentExamTarget?
  goals               StudentGoal[]

  @@index([sectionId])
  @@index([role])
  @@index([onboardingSchoolId])
  @@index([onboardingBoardId])
  @@map("users")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── AI Tutor chat ────────────────────────────────────────────────────────────

model AiTutorChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiTutorChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_tutor_chat_sessions")
}

model AiTutorChatMessage {
  id          String                  @id @default(cuid())
  sessionId   String
  session     AiTutorChatSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        AiTutorMessageRole
  content     String
  attachments Json?
  feedback    AiTutorMessageFeedback?
  createdAt   DateTime                @default(now())

  @@index([sessionId, createdAt])
  @@index([feedback])
  @@map("ai_tutor_chat_messages")
}

model StudentExamTarget {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examName  String
  examDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_exam_targets")
}

model StudentGoal {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          StudentGoalType
  title         String
  description   String?
  rationale     String?
  targetCount   Int               @default(1)
  progressCount Int               @default(0)
  status        StudentGoalStatus @default(ACTIVE)
  periodStart   DateTime
  periodEnd     DateTime
  priority      Int               @default(0)
  href          String?
  metadata      Json?
  source        StudentGoalSource
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completedAt   DateTime?

  @@index([userId, status, periodEnd])
  @@index([userId, status, priority])
  @@map("student_goals")
}

// ─── Student performance tracking ─────────────────────────────────────────────

enum NoteProgressStatus {
  VIEWED
  COMPLETED
}

model QuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  scorePercent     Int
  correctCount     Int
  totalQuestions   Int
  timeSpentSeconds Int?
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  answers QuizAttemptAnswer[]

  @@index([userId, completedAt(sort: Desc)])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  selectedOptionId String
  isCorrect        Boolean

  @@index([attemptId])
  @@map("quiz_attempt_answers")
}

model NoteProgress {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId        String
  note          Note               @relation(fields: [noteId], references: [id], onDelete: Cascade)
  status        NoteProgressStatus
  firstViewedAt DateTime           @default(now())
  lastViewedAt  DateTime           @updatedAt
  completedAt   DateTime?

  @@unique([userId, noteId])
  @@index([userId, lastViewedAt(sort: Desc)])
  @@map("note_progress")
}

model StudentNotification {
  id        String                      @id @default(cuid())
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dedupeKey String
  kind      StudentNotificationKind
  priority  StudentNotificationPriority @default(NORMAL)
  title     String
  body      String
  href      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("student_notifications")
}

model StudentReportCard {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Report Card")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examColumns ReportCardExamColumn[]
  scores      ReportCardSubjectScore[]

  @@map("student_report_cards")
}

model ReportCardExamColumn {
  id           String            @id @default(cuid())
  reportCardId String
  reportCard   StudentReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  examKey      String
  label        String
  maxMarks     Int
  orderIndex   Int               @default(0)

  @@unique([reportCardId, examKey])
  @@index([reportCardId])
  @@map("report_card_exam_columns")
}

model ReportCardSubjectScore {
  id            String            @id @default(cuid())
  reportCardId  String
  reportCard    StudentReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examKey       String
  obtainedMarks Int?

  @@unique([reportCardId, subjectId, examKey])
  @@index([reportCardId])
  @@map("report_card_subject_scores")
}

// ─── Support tickets ──────────────────────────────────────────────────────────

model SupportTicket {
  id           String                 @id @default(cuid())
  ticketNumber String                 @unique
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueArea    SupportTicketIssueArea
  message      String                 @db.Text
  status       SupportTicketStatus    @default(OPEN)
  adminNote    String?                @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_tickets")
}
