generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Gender {
  MALE
  FEMALE
}

enum UserRole {
  ADMIN
  STUDENT
}

enum BoardKind {
  BOARD
  UNIVERSITY
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SchoolSubscriptionStatus {
  ACTIVE
  INACTIVE
  HOLD
  BLOCKED
}

enum StudentMailStatus {
  NOT_SENT
  SENT
}

// ─── Board / University ───────────────────────────────────────────────────────

model Board {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  kind      BoardKind
  code      String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schools School[]

  @@map("boards")
}

// ─── School ───────────────────────────────────────────────────────────────────

model School {
  id                 String                   @id @default(cuid())
  name               String
  code               String?                  @unique
  boardId            String
  board              Board                    @relation(fields: [boardId], references: [id], onDelete: Restrict)
  subscriptionStatus SchoolSubscriptionStatus @default(ACTIVE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  classes Class[]

  @@index([boardId])
  @@map("schools")
}

// ─── Class (a grade offered at a school) ────────────────────────────────────────

model Class {
  id        String   @id @default(cuid())
  name      String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections Section[]
  subjects Subject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

// ─── Section (a division of a class) ────────────────────────────────────────────

model Section {
  id        String   @id @default(cuid())
  name      String
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students User[]

  @@unique([classId, name])
  @@index([classId])
  @@map("sections")
}

// ─── Subject ──────────────────────────────────────────────────────────────────

model Subject {
  id         String   @id @default(cuid())
  title      String
  slug       String
  imageUrl   String?
  orderIndex Int      @default(0)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chapters Chapter[]

  @@unique([classId, slug])
  @@index([classId])
  @@map("subjects")
}

// ─── Chapter ──────────────────────────────────────────────────────────────────

model Chapter {
  id         String   @id @default(cuid())
  title      String
  slug       String
  number     Int
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics  Topic[]
  quizzes Quiz[]

  @@unique([subjectId, number])
  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("chapters")
}

// ─── Topic ──────────────────────────────────────────────────────────────────

model Topic {
  id         String   @id @default(cuid())
  title      String
  slug       String
  orderIndex Int      @default(0)
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notes Note[]

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@map("topics")
}

// ─── Note (structured block content) ────────────────────────────────────────────

model Note {
  id         String   @id @default(cuid())
  title      String
  orderIndex Int      @default(0)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  blocks     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([topicId])
  @@map("notes")
}

// ─── Quiz ──────────────────────────────────────────────────────────────────

model Quiz {
  id         String         @id @default(cuid())
  title      String
  difficulty QuizDifficulty @default(MEDIUM)
  orderIndex Int            @default(0)
  chapterId  String
  chapter    Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  questions Question[]

  @@index([chapterId])
  @@map("quizzes")
}

// ─── Question (MCQ) ──────────────────────────────────────────────────────────

model Question {
  id          String   @id @default(cuid())
  prompt      String
  explanation String?
  orderIndex  Int      @default(0)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options Option[]

  @@index([quizId])
  @@map("questions")
}

// ─── Option (MCQ choice) ──────────────────────────────────────────────────────

model Option {
  id         String   @id @default(cuid())
  label      String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@map("options")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  studentCode  String?  @unique
  phone        String?
  mailStatus   StudentMailStatus @default(NOT_SENT)
  firstName    String
  lastName     String   @default("")
  gender       Gender   @default(FEMALE)
  role         UserRole @default(STUDENT)
  sectionId    String?
  section      Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]

  @@index([sectionId])
  @@index([role])
  @@map("users")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
